# Local databases (never commit; cropshield.db is created at startup)
*.db
*.db-wal
*.db-shm
*.db-journal

# Synthetic legacy datasets (replaced by real NASA POWER data in ml/data/nasa_power_raw/).
# Kept locally for reference only; the README in that folder is committed.
ml/data/legacy_synthetic/*
!ml/data/legacy_synthetic/README.md

# Portable XGBoost export (regenerated by ml/training/train_model.py; runtime loads the .joblib)
ml/training/saved_models/pest_risk_model.json

# Local scratch / tooling
*.log
.claude/
