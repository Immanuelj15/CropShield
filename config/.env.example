# CropShield Environment Configuration
# Copy this file to config/.env (native runs) and fill in your values.
# config/.env and .env are git-ignored: never commit real secrets.
# For Docker Compose, put the same variables in a `.env` file next to docker-compose.yml.

# ── App Settings ────────────────────────────────────────────
# development | production. With APP_ENV=production the API refuses to start unless
# SECRET_KEY is set (>= 16 chars, not a placeholder), and demo P&L CSVs are not auto-seeded.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# JWT signing secret (REQUIRED in production, >= 16 random chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty in development, a random per-process key is used and every token becomes
# invalid when the server restarts.
SECRET_KEY=

# ── Database ────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017/cropshield_db
MONGODB_DB_NAME=cropshield_db
# Legacy SQLite store (still written by /predict-today, /detect, /yield/predict):
DATABASE_URL=sqlite:///./cropshield.db

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list (or a JSON array) of browser origins allowed to call the API.
# Not needed when the frontend is served from the same origin (nginx proxy).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── NASA POWER API ──────────────────────────────────────────
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# ── ML Model (committed artifacts; paths are relative to the repo root) ──
MODEL_PATH=ml/training/saved_models/pest_risk_model.joblib
SCALER_PATH=ml/training/saved_models/scaler.joblib
FEATURE_NAMES_PATH=ml/training/saved_models/feature_names.json

# ── Web Push (VAPID) ────────────────────────────────────────
# Leave both empty to disable web push (GET /notifications/vapid-public-key then returns
# {"public_key": null, "push_enabled": false}). Generate a pair with e.g.
#   npx web-push generate-vapid-keys
# The key pair and JWT secret that used to be committed in git history are compromised: do not reuse them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:admin@agriguard.in

# ── SMS / WhatsApp (optional, Twilio; `pip install twilio`) ──
# Without these, SMS/WhatsApp delivery is simulated (logged only). Messages are only sent to
# users who saved a real phone number in their notification preferences.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# ── Default Location (Kovilpatti, Tamil Nadu) ───────────────
DEFAULT_LATITUDE=9.1728
DEFAULT_LONGITUDE=77.8710
DEFAULT_LOCATION=Kovilpatti
